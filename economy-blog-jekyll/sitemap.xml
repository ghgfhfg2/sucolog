---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | concat: site.posts %}
  {% assign seen_urls = "|" %}
  {% for p in pages %}
    {% assign clean_url = p.url | replace:'index.html','' %}
    {% assign url_key = clean_url | prepend:'|' | append:'|' %}
    {% unless p.sitemap == false or p.url contains '/assets/' or seen_urls contains url_key %}
  <url>
    <loc>{{ clean_url | absolute_url }}</loc>
    <lastmod>{% if p.date %}{{ p.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
      {% assign seen_urls = seen_urls | append: clean_url | append:'|' %}
    {% endunless %}
  {% endfor %}
</urlset>
